name: 🚐 Deploy to velixir

on:
  push:
    branches: ["**"]
    tags: ["**"]
    paths:
      - "apps/primary/**"
      - "packages/**"
  delete:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    concurrency:
      group: velixir-deploy
      cancel-in-progress: false
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - name: 🚀 Setup Bun
        uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest

      - name: 📦 Cache Bun install
        uses: actions/cache@v4
        with:
          path: ~/.bun/install/cache
          key: ${{ runner.os }}-bun-${{ hashFiles('**/bun.lock*') }}
          restore-keys: |
            ${{ runner.os }}-bun-

      - name: 📦 Install Dependencies
        working-directory: apps/primary
        run: bun install

      - name: 🏗️ Build app
        working-directory: apps/primary
        run: bun run build:velixir

      - name: ✅ Verify build output
        working-directory: apps/primary
        run: |
          if [ ! -f ".output/server/index.mjs" ]; then
            echo "::error::.output/server/index.mjs not found — Nitro build did not produce the expected entry point"
            ls -laR .output 2>/dev/null || echo "::error::.output directory does not exist at all"
            exit 1
          fi
          echo "Build output verified:"
          ls -la .output .output/server .output/public 2>/dev/null

      - name: Install the velixir CLI
        shell: bash
        run: |
          curl -fsSL https://velixir.net/install.sh | sh
          echo "$HOME/.velixir/bin" >> "$GITHUB_PATH"

      - name: Deploy all apps
        env:
          APPS_URL: ${{ secrets.VELIXIR_APPS_URL }}
        run: |
          set -uo pipefail   # no -e: one bad entry must not stop the rest

          if [ -z "$APPS_URL" ]; then
            echo "::error::Add the VELIXIR_APPS_URL secret (points at your data.json) under Settings > Secrets and variables > Actions."
            exit 1
          fi

          # ---------- 1. Fetch app list ----------
          DATA=$(curl -fsSL --retry 3 --retry-delay 2 --max-time 30 "$APPS_URL") || {
            echo "::error::Could not fetch app list from VELIXIR_APPS_URL"; exit 1; }

          if ! jq -e 'type == "array" and length > 0' <<<"$DATA" >/dev/null 2>&1; then
            echo "::error::App list is not a non-empty JSON array"; exit 1
          fi

          # ---------- 2. Mask runtime-fetched keys (not auto-masked by GitHub) ----------
          while IFS= read -r k; do
            [ -n "$k" ] && echo "::add-mask::$k"
          done < <(jq -r '.[].KEY // empty' <<<"$DATA")

          # ---------- 3. Loop over apps ----------
          COUNT=$(jq length <<<"$DATA")
          OK=0; FAIL=0; FAILED_LIST=""

          for i in $(seq 0 $((COUNT - 1))); do
            KEY=$(jq -r ".[$i].KEY // empty" <<<"$DATA")
            APP_ID=$(jq -r ".[$i].APP_ID // empty" <<<"$DATA")

            if [ -z "$KEY" ] || [ -z "$APP_ID" ]; then
              echo "::warning::Entry #$i is missing KEY or APP_ID, skipping"
              FAIL=$((FAIL + 1)); FAILED_LIST="$FAILED_LIST #$i(invalid)"
              continue
            fi

            echo "::group::[$((i + 1))/$COUNT] Deploying app $APP_ID"
            if VELIXIR_API_KEY="$KEY" VELIXIR_APP_ID="$APP_ID" \
               timeout 600 velixir deploy --source-dir ./apps/primary/.output --app "$APP_ID" --start "cross-env NODE_ENV=production node ./server/index.mjs" </dev/null; then
              echo "✅ ok"; OK=$((OK + 1))
            else
              echo "::warning::Deploy failed for app $APP_ID"
              FAIL=$((FAIL + 1)); FAILED_LIST="$FAILED_LIST $APP_ID"
            fi
            echo "::endgroup::"
          done

          # ---------- 4. Summary ----------
          {
            echo "### Velixir deploy results"
            echo "- ✅ Succeeded: $OK"
            echo "- ❌ Failed: $FAIL${FAILED_LIST:+ (${FAILED_LIST# })}"
          } >> "$GITHUB_STEP_SUMMARY"

          # Every app was attempted; now surface failures by turning the job red
          [ "$FAIL" -eq 0 ] || exit 1
